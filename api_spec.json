    "components": {
        "schemas": {
            "DoacaoBase": {
                "properties": {
                    "itens": {
                        "items": {
                            "$ref": "#/components/schemas/DoacaoItemBase"
                        },
                        "type": "array",
                        "minItems": 1,
                        "title": "Itens"
                    },
                    "data_agendamento": {
                        "type": "string",
                        "format": "date",
                        "title": "Data Agendamento"
                    },
                    "hora_agendamento": {
                        "type": "string",
                        "format": "time",
                        "title": "Hora Agendamento"
                    },
                    "observacao": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Observacao"
                    }
                },
                "type": "object",
                "required": [
                    "itens",
                    "data_agendamento",
                    "hora_agendamento"
                ],
                "title": "DoacaoBase",
                "description": "Schema base para doações."
            },
            "DoacaoItemBase": {
                "properties": {
                    "id_item": {
                        "type": "integer",
                        "title": "Id Item"
                    },
                    "quantidade": {
                        "type": "integer",
                        "exclusiveMinimum": 0.0,
                        "title": "Quantidade"
                    }
                },
                "type": "object",
                "required": [
                    "id_item",
                    "quantidade"
                ],
                "title": "DoacaoItemBase",
                "description": "Schema para um item dentro de uma doação."
            },
            "DoacaoItemOut": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "id_item": {
                        "type": "integer",
                        "title": "Id Item"
                    },
                    "quantidade": {
                        "type": "integer",
                        "title": "Quantidade"
                    },
                    "item": {
                        "$ref": "#/components/schemas/ItemEmbutido"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "id_item",
                    "quantidade",
                    "item"
                ],
                "title": "DoacaoItemOut",
                "description": "Schema de saída para um item de doação."
            },
            "DoacaoOut": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "id_usuario": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Id Usuario"
                    },
                    "usuario": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/DoadorOut"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "itens": {
                        "items": {
                            "$ref": "#/components/schemas/DoacaoItemOut"
                        },
                        "type": "array",
                        "title": "Itens"
                    },
                    "data_agendamento": {
                        "type": "string",
                        "format": "date",
                        "title": "Data Agendamento"
                    },
                    "hora_agendamento": {
                        "type": "string",
                        "format": "time",
                        "title": "Hora Agendamento"
                    },
                    "status_doacao": {
                        "$ref": "#/components/schemas/DoacaoStatus"
                    },
                    "observacao": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Observacao"
                    },
                    "criado_em": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Criado Em"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "id_usuario",
                    "itens",
                    "data_agendamento",
                    "hora_agendamento",
                    "status_doacao",
                    "criado_em"
                ],
                "title": "DoacaoOut",
                "description": "Schema de saída de doação."
            },
            "DoacaoStatus": {
                "type": "string",
                "enum": [
                    "agendada",
                    "recebida",
                    "rejeitada"
                ],
                "title": "DoacaoStatus"
            },
            "DoacaoStatusUpdate": {
                "properties": {
                    "status_doacao": {
                        "$ref": "#/components/schemas/DoacaoStatus"
                    }
                },
                "type": "object",
                "required": [
                    "status_doacao"
                ],
                "title": "DoacaoStatusUpdate",
                "description": "Schema para atualização de status de doação."
            },
            "DoadorOut": {
                "properties": {
                    "nome": {
                        "type": "string",
                        "title": "Nome"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email"
                    }
                },
                "type": "object",
                "required": [
                    "nome",
                    "email"
                ],
                "title": "DoadorOut",
                "description": "Schema simplificado de um doador."
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ItemCategoria": {
                "type": "string",
                "enum": [
                    "Alimento",
                    "Higiene",
                    "Limpeza",
                    "Vestuario",
                    "Outros"
                ],
                "title": "ItemCategoria"
            },
            "ItemCreate": {
                "properties": {
                    "nome_item": {
                        "type": "string",
                        "title": "Nome Item"
                    },
                    "categoria": {
                        "$ref": "#/components/schemas/ItemCategoria"
                    },
                    "prioridade_status": {
                        "$ref": "#/components/schemas/ItemPrioridade",
                        "default": "media"
                    },
                    "quantidade_atual": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Quantidade Atual",
                        "default": 0
                    }
                },
                "type": "object",
                "required": [
                    "nome_item",
                    "categoria"
                ],
                "title": "ItemCreate",
                "description": "Schema para criação de item."
            },
            "ItemEmbutido": {
                "properties": {
                    "nome_item": {
                        "type": "string",
                        "title": "Nome Item"
                    },
                    "categoria": {
                        "$ref": "#/components/schemas/ItemCategoria"
                    },
                    "prioridade_status": {
                        "$ref": "#/components/schemas/ItemPrioridade"
                    },
                    "quantidade_atual": {
                        "type": "integer",
                        "title": "Quantidade Atual"
